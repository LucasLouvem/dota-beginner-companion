# Copie para .env e ajuste. Valores aqui têm prioridade sobre ~/.config/dota-companion/config.toml.

# Porta do servidor GSI local (padrão: 53000). Reinstale o arquivo GSI após mudar.
# DOTA_COMPANION_GSI_PORT=53000

# Bibliotecas Steam extras, separadas por ":".
# DOTA_COMPANION_EXTRA_LIBRARIES=/mnt/jogos/SteamLibrary:/outro/disco/SteamLibrary

# Nível de log (error, warn, info, debug, trace).
# RUST_LOG=info
