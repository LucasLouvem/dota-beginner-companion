# Execute cp .env.example .env e ajuste se necessário.
# Valores aqui têm prioridade sobre ~/.config/dota-companion/config.toml.

# Porta do servidor GSI local (padrão: 53000). Reinstale o arquivo GSI após mudar.
DOTA_COMPANION_GSI_PORT=53000

# Bibliotecas Steam extras, separadas por ":".
DOTA_COMPANION_EXTRA_LIBRARIES=/mnt/jogos/SteamLibrary

# Nível de log (error, warn, info, debug, trace).
RUST_LOG=info

# Grava cada evento GSI recebido do Dota em um arquivo JSON Lines (desenvolvimento).
# O arquivo contém SteamID e nome do jogador; a pasta logs/ é ignorada pelo git.
# Deixe vazio para não habilitar pelo .env; para habilitar, use logs/gsi.jsonl.
DOTA_COMPANION_GSI_LOG=
